{
  "format": "actcraft-scenario/1",
  "name": "orthographe",
  "description": "S21 (L6-T34) : vérification de l'orthographe (F7). Page 1 « le chat dort » ; page 2 « bonjour mosieur » et « exemplle ». spell.check depuis la page 1 : la page 2 s'affiche, « mosieur » est surligné (capture mot) avec la suggestion « monsieur » ; Entrée remplace ; « exemplle » est ignoré toujours (Alt+T) ; fin de la vérification (capture fin) ; le texte relu vaut « bonjour monsieur ».",
  "steps": [
    {"waitReady": true},
    {"command": "tool.text"},
    {"pointer": [[500, 200]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"command": "text.select-all"},
    {"typeText": "le chat dort"},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"command": "page.next"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 2},
    {"command": "tool.text"},
    {"pointer": [[500, 200]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"command": "text.select-all"},
    {"typeText": "bonjour mosieur"},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"command": "tool.text"},
    {"pointer": [[500, 500]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"command": "text.select-all"},
    {"typeText": "exemplle"},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"command": "page.goto", "argument": "1"},
    {"waitReady": true},
    {"expect": "documentController.currentIndex", "value": 0},
    {"command": "spell.check"},
    {"waitFor": "spellingDialog.word", "value": "mosieur", "timeoutMs": 20000},
    {"waitReady": true},
    {"expect": "documentController.currentIndex", "value": 1},
    {"expect": "spellingDialog.word", "value": "mosieur"},
    {"expect": "spellingDialog.suggestion0", "value": "monsieur"},
    {"capture": "mot"},
    {"key": "Return"},
    {"waitFor": "spellingDialog.word", "value": "exemplle", "timeoutMs": 10000},
    {"key": "Alt+T"},
    {"waitFor": "appSpelling.finished", "value": true, "timeoutMs": 10000},
    {"expect": "appSpelling.finished", "value": true},
    {"expect": "spellingDialog.message", "value": "Vérification terminée"},
    {"waitReady": true},
    {"capture": "fin"},
    {"command": "tool.text"},
    {"pointer": [[500, 200]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"expect": "appText.plainText", "value": "bonjour monsieur"}
  ]
}
