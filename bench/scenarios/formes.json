{
  "format": "actcraft-scenario/1",
  "name": "formes",
  "description": "S7.1 : palette, rectangle depuis le coin, clic simple sans forme, cercle depuis le centre sans remplissage, point intelligent d'une flèche. Le glisser du point fait une étape : Annuler la défait et garde la flèche (3 objets) ; sans étape, Annuler retirerait la flèche (2).",
  "steps": [
    {"waitReady": true},
    {"command": "tool.shape"},
    {"expect": "shapePalette.visible", "value": true},
    {"capture": "palette"},
    {"command": "shape.choose", "argument": "rectangle"},
    {"pointer": [[200, 200], [300, 260], [400, 320]]},
    {"waitReady": true},
    {"checkPixel": "rectangle-contour", "at": [200, 260], "color": "#000000", "tolerance": 60},
    {"capture": "rectangle"},
    {"pointer": [[600, 600]]},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "shape.fill-color", "argument": "#43A047"},
    {"command": "shape.choose", "argument": "circle"},
    {"command": "shape.draw-from-center"},
    {"command": "shape.filled"},
    {"pointer": [[700, 300], [730, 330], [760, 360]]},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 2},
    {"capture": "cercle-centre"},
    {"checkPixel": "cercle-interieur-blanc", "at": [700, 300], "color": "#FFFFFF", "tolerance": 8},
    {"expect": "appTools.currentTool", "value": "shape"},
    {"command": "shape.choose", "argument": "arrow"},
    {"pointer": [[300, 500], [400, 530], [500, 560]]},
    {"waitReady": true},
    {"command": "tool.select"},
    {"pointer": [[400, 530]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"expect": "selectionSmartPoint.visible", "value": true},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"pointer": [[220, 486], [220, 492], [220, 500]]},
    {"waitReady": true},
    {"capture": "fleche-point"},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"command": "edit.redo"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 3}
  ]
}
