{
  "format": "actcraft-scenario/1",
  "name": "aide-complete",
  "description": "L11-T18 (S29) : F1 ouvre le lecteur d'aide sur la page de l'outil courant (stylo, encre révélatrice), sans réseau ; le lecteur est capturé puis fermé par Échap ; en mode à deux utilisateurs F1 ouvre encore la page de l'outil courant et le bouton « ? » de la deuxième palette ouvre la page du mode à deux.",
  "steps": [
    {"waitReady": true},
    {"command": "tool.pen"},
    {"key": "F1"},
    {"waitFor": "helpViewer.visible", "value": true},
    {"expect": "helpViewer.currentPage", "value": "pen"},
    {"capture": "aide-stylo"},
    {"key": "Esc"},
    {"waitFor": "helpViewer.visible", "value": false},
    {"command": "tool.reveal-ink"},
    {"key": "F1"},
    {"waitFor": "helpViewer.visible", "value": true},
    {"expect": "helpViewer.currentPage", "value": "reveal-ink"},
    {"capture": "aide-encre-revelatrice"},
    {"key": "Esc"},
    {"waitFor": "helpViewer.visible", "value": false},
    {"command": "users.dual"},
    {"expect": "appDualMode.active", "value": true},
    {"key": "F1"},
    {"waitFor": "helpViewer.visible", "value": true},
    {"expect": "helpViewer.currentPage", "value": "reveal-ink"},
    {"key": "Esc"},
    {"waitFor": "helpViewer.visible", "value": false},
    {"tap": "secondHelp"},
    {"waitFor": "helpViewer.visible", "value": true},
    {"expect": "helpViewer.currentPage", "value": "deux-utilisateurs"},
    {"capture": "aide-deux-utilisateurs"},
    {"key": "Esc"},
    {"waitFor": "helpViewer.visible", "value": false},
    {"command": "users.dual"},
    {"expect": "appDualMode.active", "value": false}
  ]
}
