    {"wait": 200},
    {"expect": "helpViewer.visible", "value": false},
    {"command": "tool.reveal-ink"},
    {"key": "F1"},
    {"wait": 400},
    {"expect": "helpViewer.visible", "value": true},
    {"capture": "aide-encre-revelatrice"},
