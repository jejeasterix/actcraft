    {"wait": 200},
    {"expect": "helpViewer.visible", "value": false},
    {"command": "users.dual"},
    {"expect": "appDualMode.active", "value": true},
    {"key": "F1"},
    {"wait": 400},
    {"expect": "helpViewer.visible", "value": true},
    {"capture": "aide-deux-utilisateurs"},
    {"key": "Esc"},
    {"wait": 200},
    {"expect": "helpViewer.visible", "value": false},
    {"command": "users.dual"},
    {"expect": "appDualMode.active", "value": false}
