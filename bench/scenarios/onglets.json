{
 "format": "actcraft-scenario/1",
 "name": "onglets",
 "description": "S8.5 : barre d'onglets (visible dès deux documents), trois onglets ouverts par Ctrl+Alt+N, bascule par un clic, première page du premier onglet glissée sur le deuxième (copiée avant sa première page), fermeture d'un onglet propre par sa croix. La capture du deuxième onglet attend les miniatures : une bascule les remarque toutes (L5-C10).",
 "steps": [
  {"waitReady": true},
  {"expect": "appTabs.count", "value": 1},
  {"expect": "documentTabBar.visible", "value": false},
  {"stroke": [[300, 300], [500, 300]], "pressure": 0.5},
  {"waitReady": true},
  {"command": "page.insert-after"},
  {"expect": "documentController.pageCount", "value": 2},
  {"command": "view.browsers"},
  {"waitReady": true},
  {"key": "Ctrl+Alt+N"},
  {"waitFor": "appTabs.count", "value": 2, "timeoutMs": 5000},
  {"expect": "documentTabBar.visible", "value": true},
  {"key": "Ctrl+Alt+N"},
  {"waitFor": "appTabs.count", "value": 3, "timeoutMs": 5000},
  {"waitReady": true},
  {"capture": "trois-onglets"},
  {"pointer": [[110, 64]], "space": "window"},
  {"waitFor": "appTabs.currentIndex", "value": 0, "timeoutMs": 5000},
  {"waitReady": true},
  {"expect": "documentController.pageCount", "value": 2},
  {"capture": "premier"},
  {"pointer": [[110, 232], [110, 200], [200, 120], [330, 64]], "space": "window"},
  {"waitReady": true},
  {"expect": "documentController.pageCount", "value": 2},
  {"pointer": [[330, 64]], "space": "window"},
  {"waitFor": "appTabs.currentIndex", "value": 1, "timeoutMs": 5000},
  {"waitReady": true},
  {"expect": "appTabs.count", "value": 3},
  {"expect": "appTabs.currentIndex", "value": 1},
  {"expect": "documentController.pageCount", "value": 2},
  {"waitFor": "appThumbnails.pendingCount", "value": 0, "timeoutMs": 10000},
  {"capture": "deuxieme"}
 ]
}
