{
 "format": "actcraft-scenario/1",
 "name": "edition-export",
 "description": "S8 : trois rectangles groupés et un rectangle seul dans l'onglet 1 ; le groupe et la forme seule (deux objets de premier niveau) sont copiés ; file.new crée l'onglet 2 ; le collage garde les deux objets collés sélectionnés ; align.left les aligne à gauche, edit.undo annule l'alignement seul (le collage reste annulable) ; le document de trois pages est exporté en PDF (3 pages) et la page en image (1024 x 768), contrôlés sur les fichiers écrits.",
 "steps": [
  {"waitReady": true},
  {"command": "tool.shape"},
  {"command": "shape.choose", "argument": "rectangle"},
  {"pointer": [[200, 150], [250, 190], [300, 220]]},
  {"pointer": [[350, 150], [400, 190], [450, 220]]},
  {"pointer": [[200, 280], [250, 310], [300, 340]]},
  {"pointer": [[600, 300], [650, 340], [700, 380]]},
  {"waitReady": true},
  {"expect": "documentController.shownObjectCount", "value": 4},
  {"command": "tool.select"},
  {"pointer": [[150, 100], [300, 200], [500, 400]]},
  {"expect": "appTools.selectionCount", "value": 3},
  {"command": "object.group"},
  {"waitReady": true},
  {"expect": "appEditing.selectionIsGroup", "value": true},
  {"expect": "appTools.selectionCount", "value": 1},
  {"pointer": [[650, 340]], "modifiers": ["shift"]},
  {"expect": "appTools.selectionCount", "value": 2},
  {"capture": "onglet-1-selection"},
  {"command": "edit.copy"},
  {"expect": "appTabs.count", "value": 1},
  {"command": "file.new"},
  {"waitFor": "appTabs.count", "value": 2, "timeoutMs": 5000},
  {"waitReady": true},
  {"expect": "appTabs.currentIndex", "value": 1},
  {"expect": "documentController.shownObjectCount", "value": 0},
  {"command": "edit.paste"},
  {"waitReady": true},
  {"expect": "documentController.shownObjectCount", "value": 5},
  {"expect": "appTools.selectionCount", "value": 2},
  {"checkPixel": "forme-seule-collee", "at": [670, 360], "color": "#FFAA00", "tolerance": 40},
  {"checkPixel": "bord-gauche-libre", "at": [260, 385], "color": "#FFFFFF", "tolerance": 8},
  {"capture": "onglet-2-colle"},
  {"command": "align.left"},
  {"waitReady": true},
  {"expect": "appTools.selectionCount", "value": 2},
  {"checkPixel": "forme-seule-alignee", "at": [260, 385], "color": "#FFAA00", "tolerance": 40},
  {"checkPixel": "ancien-emplacement-vide", "at": [670, 360], "color": "#FFFFFF", "tolerance": 8},
  {"checkPixel": "groupe-garde-sa-forme", "at": [400, 185], "color": "#FFAA00", "tolerance": 40},
  {"capture": "onglet-2-aligne"},
  {"command": "edit.undo"},
  {"waitReady": true},
  {"expect": "documentController.canUndo", "value": true},
  {"expect": "documentController.shownObjectCount", "value": 5},
  {"checkPixel": "alignement-annule", "at": [260, 385], "color": "#FFFFFF", "tolerance": 8},
  {"checkPixel": "forme-seule-revenue", "at": [670, 360], "color": "#FFAA00", "tolerance": 40},
  {"capture": "onglet-2-annule"},
  {"command": "export.page-image", "argument": "${SORTIE}/s8.png"},
  {"waitFor": "appExchange.busy", "value": false, "timeoutMs": 15000},
  {"file": "${SORTIE}/s8.png", "imageSize": [1024, 768]},
  {"command": "page.insert-after"},
  {"command": "page.insert-after"},
  {"waitReady": true},
  {"expect": "documentController.pageCount", "value": 3},
  {"command": "export.pdf", "argument": "${SORTIE}/s8.pdf"},
  {"waitFor": "appExchange.busy", "value": false, "timeoutMs": 15000},
  {"file": "${SORTIE}/s8.pdf", "pdfPages": 3},
  {"expect": "appTabs.count", "value": 2}
 ]
}
