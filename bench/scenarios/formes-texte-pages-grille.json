{
  "format": "actcraft-scenario/1",
  "name": "formes-texte-pages-grille",
  "description": "S7 : un rectangle tracé, « Bonjour » posé par touches injectées (la miniature de la page se met à jour), grille aimantée (le rectangle déplacé pose son coin bas gauche sur une intersection), page 3 glissée avant la page 1 dans le navigateur.",
  "steps": [
    {"waitReady": true},
    {"command": "view.browsers"},
    {"command": "page.next"},
    {"command": "page.next"},
    {"command": "page.goto", "argument": "1"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 3},
    {"command": "tool.shape"},
    {"command": "shape.choose", "argument": "rectangle"},
    {"pointer": [[212, 212], [262, 250], [312, 292]]},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"remember": "appThumbnails.renderCount", "as": "r0"},
    {"command": "tool.text"},
    {"pointer": [[500, 200]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"command": "text.select-all"},
    {"typeText": "Bonjour"},
    {"expect": "appText.plainText", "value": "Bonjour"},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitFor": "appThumbnails.renderCount", "value": "${r0}", "above": true, "timeoutMs": 3000},
    {"expect": "appThumbnails.renderCount", "value": "${r0}", "above": true},
    {"waitReady": true},
    {"capture": "miniature"},
    {"command": "grid.designer"},
    {"expect": "gridDesigner.visible", "value": true},
    {"command": "grid.snap"},
    {"expect": "appPageSettings.gridSnap", "value": true},
    {"key": "Return"},
    {"waitReady": true},
    {"expect": "gridDesigner.visible", "value": false},
    {"command": "tool.select"},
    {"pointer": [[260, 250], [275, 250], [290, 250]]},
    {"waitReady": true},
    {"capture": "accroche"},
    {"checkPixel": "coin-accroche", "at": [248, 270], "color": "#FFFFFF", "tolerance": 30},
    {"checkPixel": "coin-accroche-interieur", "at": [262, 278], "color": "#FFAA00", "tolerance": 60},
    {"checkPixel": "coin-accroche-bas", "at": [270, 291], "color": "#FFFFFF", "tolerance": 30},
    {"command": "page.goto", "argument": "2"},
    {"waitReady": true},
    {"expect": "documentController.currentIndex", "value": 1},
    {"pointer": [[110, 464], [110, 300], [110, 150]], "space": "window"},
    {"waitReady": true},
    {"expect": "documentController.currentIndex", "value": 0},
    {"expect": "documentController.pageCount", "value": 3},
    {"checkPixel": "page-vide-devant", "at": [262, 278], "color": "#FFFFFF", "tolerance": 30},
    {"capture": "pages"}
  ]
}
