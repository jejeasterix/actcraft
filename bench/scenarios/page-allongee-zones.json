{
  "format": "actcraft-scenario/1",
  "name": "page-allongee-zones",
  "description": "S15 : la poignée allonge la page d'un pas cumulé par clic, sans changer d'outil ; puis les séparations pointillées des cadres (2 cadres, puis 2 × 3) sont dessinées en surcouche, sans redessin du cache, en plein écran aussi, et sans prendre l'entrée.",
  "steps": [
    {"waitReady": true},
    {"command": "view.page-extension"},
    {"expect": "pageExtensionHandle.visible", "value": true},
    {"expect": "pageExtensionHandle.atPageBottom", "value": true},
    {"pointer": [[512, 762]]},
    {"waitReady": true},
    {"expect": "pageExtensionHandle.atPageBottom", "value": true},
    {"pointer": [[512, 838.8]]},
    {"waitReady": true},
    {"expect": "pageExtensionHandle.atPageBottom", "value": true},
    {"pointer": [[512, 923.28]]},
    {"waitReady": true},
    {"expect": "pageExtensionHandle.atPageBottom", "value": true},
    {"expect": "appPageSettings.pageHeight", "value": 1022.208, "tolerance": 0.01},
    {"expect": "appTools.currentTool", "value": "pen"},
    {"capture": "allongee"},
    {"command": "view.zoom", "argument": 150},
    {"waitReady": true},
    {"expect": "pageExtensionHandle.atPageBottom", "value": true},
    {"command": "view.fit"},
    {"waitReady": true},
    {"command": "edit.undo"},
    {"command": "edit.undo"},
    {"command": "edit.undo"},
    {"expect": "appPageSettings.pageHeight", "value": 768, "tolerance": 0.01},
    {"waitReady": true},
    {"checkEdge": "separation-absente", "from": [508, 300], "to": [516, 336], "maxIntermediate": 0, "minInk": 0},
    {"remember": "pageView.cacheRefreshCount", "as": "r"},
    {"command": "page.zones", "argument": "2x0"},
    {"waitReady": true},
    {"expect": "appPageSettings.zones", "value": "2x0"},
    {"expect": "pageZones.separatorCount", "value": 1},
    {"expect": "pageView.cacheRefreshCount", "value": "${r}"},
    {"capture": "zones"},
    {"checkEdge": "separation-zone", "from": [508, 300], "to": [516, 336], "minIntermediate": 1, "minInk": 0},
    {"stroke": [[500, 400], [530, 420]], "pressure": 0.5},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "page.zones", "argument": "2x3"},
    {"waitReady": true},
    {"expect": "pageZones.separatorCount", "value": 3},
    {"command": "view.fullscreen"},
    {"waitReady": true},
    {"expect": "pageZones.visible", "value": true},
    {"expect": "pageZones.separatorCount", "value": 3},
    {"capture": "zones-plein-ecran"},
    {"command": "view.fullscreen"},
    {"waitReady": true},
    {"remember": "documentController.fingerprint", "as": "avant"},
    {"command": "file.save-as", "argument": "${SORTIE}/z.actcraft"},
    {"waitFor": "documentController.busy", "value": false},
    {"command": "file.open", "argument": "${SORTIE}/z.actcraft"},
    {"waitFor": "documentController.busy", "value": false},
    {"waitReady": true},
    {"expect": "documentController.fingerprint", "value": "${avant}"}
  ]
}
