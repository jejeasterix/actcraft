{
  "format": "actcraft-scenario/1",
  "name": "profils-complets",
  "description": "S32 (L11-T27) : les cinq profils fournis activés depuis un profil vierge ; pour chacun, l'identifiant courant, le navigateur de pages et les pastilles sont relus, puis l'écran est capturé.",
  "steps": [
    {"waitReady": true},
    {"command": "profile.activate", "argument": "en-classe"},
    {"wait": 400},
    {"expect": "appProfile.currentId", "value": "en-classe"},
    {"expect": "appProfile.browsersVisible", "value": false},
    {"expect": "appProfile.swatches", "value": 16},
    {"capture": "en-classe"},
    {"command": "profile.activate", "argument": "preparation"},
    {"wait": 400},
    {"expect": "appProfile.currentId", "value": "preparation"},
    {"expect": "appProfile.browsersVisible", "value": true},
    {"expect": "appProfile.swatches", "value": 24},
    {"capture": "preparation"},
    {"command": "profile.activate", "argument": "lecture-ecriture"},
    {"wait": 400},
    {"expect": "appProfile.currentId", "value": "lecture-ecriture"},
    {"expect": "appProfile.browsersVisible", "value": false},
    {"expect": "appProfile.swatches", "value": 16},
    {"capture": "lecture-ecriture"},
    {"command": "profile.activate", "argument": "calcul-geometrie"},
    {"wait": 400},
    {"expect": "appProfile.currentId", "value": "calcul-geometrie"},
    {"expect": "appProfile.browsersVisible", "value": false},
    {"expect": "appProfile.swatches", "value": 16},
    {"capture": "calcul-geometrie"},
    {"command": "profile.activate", "argument": "son-image"},
    {"wait": 400},
    {"expect": "appProfile.currentId", "value": "son-image"},
    {"expect": "appProfile.browsersVisible", "value": false},
    {"expect": "appProfile.swatches", "value": 16},
    {"capture": "son-image"}
  ]
}
