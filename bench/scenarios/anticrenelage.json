{
  "format": "actcraft-scenario/1",
  "name": "anticrenelage",
  "description": "S33 : trait noir diagonal lissé quand il vient d'être tracé (en attente au-dessus du cache : fixedPage.pendingCount = 1), après son versement au cache (pendingCount = 0) et au zoom 300 % ; grille nette. L'attente pageCache.samples = 4 est une garde de constante : elle relit la propriété samples du cache (ui/qml/PageArea.qml), égale à kMsaaSamples (app/renderbackend.h), à changer ensemble ; elle ne prouve pas l'échantillonnage multiple. La preuve à l'écran, en Direct3D 11, est checkEdge (trait-diagonal, trait-verse, trait-zoom).",
  "steps": [
    {"waitReady": true},
    {"expect": "pageCache.samples", "value": 4},
    {"fixture": "grille", "path": "${SORTIE}/grille.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/grille.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"expect": "documentController.title", "value": "grille"},
    {"expect": "pageIndicator.text", "value": "1 / 1"},
    {"command": "view.zoom", "argument": 100},
    {"waitReady": true},
    {"checkEdge": "grille-nette", "from": [100, 40], "to": [100, 90], "minIntermediate": 0, "maxIntermediate": 0, "minInk": 1},
    {"capture": "grille"},
    {"command": "pen.color", "argument": "#000000"},
    {"command": "pen.width", "argument": 8},
    {"stroke": [[300, 300], [500, 500]], "pressure": 0.5},
    {"waitReady": true},
    {"expect": "fixedPage.pendingCount", "value": 1},
    {"checkEdge": "trait-diagonal", "from": [370, 400], "to": [430, 400], "minIntermediate": 2, "minInk": 8},
    {"capture": "trait"},
    {"wait": 800},
    {"waitReady": true},
    {"expect": "fixedPage.pendingCount", "value": 0},
    {"checkEdge": "trait-verse", "from": [370, 400], "to": [430, 400], "minIntermediate": 2, "minInk": 8},
    {"command": "view.zoom", "argument": 300},
    {"waitReady": true},
    {"checkEdge": "trait-zoom", "from": [385, 400], "to": [415, 400], "minIntermediate": 2, "minInk": 24},
    {"capture": "trait-zoom"}
  ]
}
