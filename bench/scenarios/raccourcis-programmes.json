{
  "format": "actcraft-scenario/1",
  "name": "raccourcis-programmes",
  "description": "S20 (L6-T30) : un raccourci vers launcher_probe est ajouté (launcher.edit avec {path, arguments, toolTip}), lancé par launcherButton0 (launcher.run avec l'index « 0 ») ; un profil d'un autre poste demande confirmation, le refus ne lance rien ; le raccourci est retiré (launcher.edit avec {remove: 0}). Windows seulement.",
  "platforms": ["windows"],
  "steps": [
    {"waitReady": true},
    {"remember": "appProfile.currentId", "as": "depart"},
    {"command": "launcher.edit", "argument": {"path": "build/debug/tests/launcher_probe.exe", "arguments": [".tmp/temoin-1.txt"], "toolTip": "Programme d'essai"}},
    {"wait": 400},
    {"expect": "launcherButton0.toolTip", "value": "Programme d'essai"},
    {"capture": "barre"},
    {"command": "launcher.run", "argument": "0"},
    {"wait": 2000},
    {"fixture": "profil-autre-poste", "path": "${SORTIE}/autre-poste.json"},
    {"command": "profile.import", "argument": "${SORTIE}/autre-poste.json"},
    {"command": "profile.activate", "argument": "autre-poste"},
    {"wait": 400},
    {"command": "launcher.run", "argument": "0"},
    {"wait": 400},
    {"capture": "confirmation"},
    {"key": "Escape"},
    {"wait": 400},
    {"command": "profile.activate", "argument": "${depart}"},
    {"wait": 400},
    {"command": "launcher.edit", "argument": {"remove": 0}},
    {"wait": 400},
    {"expect": "shortcutBar.launcherCount", "value": "0"}
  ]
}
