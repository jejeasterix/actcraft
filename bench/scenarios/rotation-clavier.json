{
  "format": "actcraft-scenario/1",
  "name": "rotation-clavier",
  "description": "Rotation de la tablette : un trait rouge tracé en paysage reste à son point de page en portrait, puis au retour en paysage (le point de page au centre de la vue y reste).",
  "steps": [
    {"waitReady": true},
    {"resize": [1280, 800]},
    {"waitFor": "appLayout.portrait", "value": false},
    {"command": "tool.pen"},
    {"command": "pen.color", "argument": "#E53935"},
    {"stroke": [[300, 300], [500, 300]], "pressure": 0.5},
    {"wait": 200},
    {"checkPixel": "trait-paysage", "at": [400, 300], "color": "#E53935", "tolerance": 120},
    {"resize": [800, 1280]},
    {"waitFor": "appLayout.portrait", "value": true},
    {"wait": 200},
    {"checkPixel": "trait-portrait", "at": [400, 300], "color": "#E53935", "tolerance": 120},
    {"capture": "portrait"},
    {"resize": [1280, 800]},
    {"waitFor": "appLayout.portrait", "value": false},
    {"wait": 200},
    {"checkPixel": "trait-retour", "at": [400, 300], "color": "#E53935", "tolerance": 120},
    {"capture": "paysage"}
  ]
}
