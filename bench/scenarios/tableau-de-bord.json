{
  "format": "actcraft-scenario/1",
  "name": "tableau-de-bord",
  "description": "S9.9 (F-090) : tableau d'accueil. Un document d'une page puis un de trois pages sont enregistrés ou ouverts (ils entrent dans les récents, le plus récent en tête), l'application est relancée sur les mêmes réglages, l'accueil s'ouvre par view.dashboard (F11), liste deux documents récents, puis un clic sur le premier ouvre le document de trois pages et ferme l'accueil. Renvois de L6-T24 (récents gardés par les préférences, liés au résumé et au menu Fichier) et de L6-T28 (mandataire réseau appliqué au démarrage).",
  "steps": [
    {"waitReady": true},
    {"expect": "dashboard.visible", "value": false},
    {"expect": "appNetwork.port", "value": 8080},
    {"command": "file.save-as", "argument": "${SORTIE}/une-page.actcraft"},
    {"waitFor": "documentController.busy", "value": false},
    {"expect": "appRecents.count", "value": 1},
    {"command": "file.close"},
    {"waitReady": true},
    {"fixture": "trois-pages", "path": "${SORTIE}/trois-pages.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/trois-pages.actcraft"},
    {"waitFor": "documentController.busy", "value": false},
    {"expect": "documentController.pageCount", "value": 3},
    {"expect": "appRecents.count", "value": 2},
    {"command": "file.close"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 1},
    {"restart": true},
    {"waitReady": true},
    {"expect": "dashboard.visible", "value": false},
    {"command": "view.dashboard"},
    {"waitReady": true},
    {"expect": "dashboard.visible", "value": true},
    {"expect": "dashboard.recentCount", "value": 2},
    {"capture": "accueil"},
    {"pointer": [[527, 339]], "space": "window"},
    {"waitFor": "documentController.busy", "value": false},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 3},
    {"expect": "dashboard.visible", "value": false}
  ]
}
