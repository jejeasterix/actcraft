{
  "format": "actcraft-scenario/1",
  "name": "proprietes",
  "description": "S9.4 : navigateur de propriétés. Page sans sélection (titre Page), un trait noir fin, sélection du trait (titre Trait), épaisseur du contour saisie à 12 dans l'éditeur (une étape, trait épaissi), annulation (trait fin, sélection vidée, retour à la page). L6-P1 : un texte « Rouge » (taille 48) validé par Échap, sélectionné, prend la pastille rouge (swatch-0, #E53935) sans changer d'outil ni de sélection (lectures nommées) ; désélectionné par un appui dans le vide, son R se lit rouge hors de toute poignée ; une annulation le rend noir.",
  "steps": [
    {"waitReady": true},
    {"command": "pen.color", "argument": "#000000"},
    {"command": "pen.width", "argument": 2},
    {"command": "browser.properties"},
    {"waitReady": true},
    {"expect": "browserPanel.current", "value": "proprietes"},
    {"expect": "appProperties.title", "value": "Page"},
    {"capture": "page"},
    {"stroke": [[300, 400], [700, 400]], "pressure": 0.5},
    {"waitReady": true},
    {"command": "tool.select"},
    {"pointer": [[500, 400]]},
    {"waitReady": true},
    {"expect": "appTools.selectionCount", "value": 1},
    {"expect": "appProperties.title", "value": "Trait"},
    {"capture": "trait"},
    {"pointer": [[145, 539]], "space": "window"},
    {"waitFor": "prop-outline-width.activeFocus", "value": true, "timeoutMs": 5000},
    {"typeText": "12"},
    {"key": "Return"},
    {"waitReady": true},
    {"expect": "documentController.canUndo", "value": true},
    {"capture": "epais"},
    {"checkPixel": "contour-epais", "at": [400, 402], "color": "#000000", "tolerance": 60},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "appProperties.title", "value": "Page"},
    {"checkPixel": "contour-annule", "at": [400, 402], "color": "#FFFFFF", "tolerance": 60},
    {"capture": "annule"},
    {"command": "tool.text"},
    {"pointer": [[300, 300]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"typeText": "Rouge"},
    {"expect": "appText.plainText", "value": "Rouge"},
    {"command": "text.select-all"},
    {"command": "text.size", "argument": 48},
    {"key": "Escape"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 2},
    {"command": "tool.select"},
    {"pointer": [[320, 330]]},
    {"waitReady": true},
    {"expect": "appTools.selectionCount", "value": 1},
    {"expect": "appProperties.title", "value": "Texte"},
    {"expect": "swatch-0.modelData", "value": "#E53935"},
    {"pointer": [[1186, 308]], "space": "window"},
    {"waitReady": true},
    {"expect": "appTools.currentTool", "value": "select"},
    {"expect": "appTools.selectionCount", "value": 1},
    {"expect": "appProperties.title", "value": "Texte"},
    {"pointer": [[800, 200]]},
    {"waitReady": true},
    {"expect": "appTools.selectionCount", "value": 0},
    {"capture": "texte-rouge"},
    {"checkPixel": "texte-recolore", "at": [308, 340], "color": "#E53935", "tolerance": 60},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 2},
    {"capture": "texte-annule"},
    {"checkPixel": "texte-annule", "at": [308, 340], "color": "#000000", "tolerance": 60}
  ]
}
