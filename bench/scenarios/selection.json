{
  "format": "actcraft-scenario/1",
  "name": "selection",
  "description": "S34 : cliquer, rectangle qui touche, glisser, poignée proportionnelle, agrandir ; souris pour l'outil Sélectionner, stylet pour le trait versé hors du cadre.",
  "steps": [
    {"waitReady": true},
    {"stroke": [[300, 300], [500, 300]], "pressure": 0.5},
    {"stroke": [[300, 400], [500, 400]], "pressure": 0.5},
    {"waitReady": true},
    {"command": "tool.select"},
    {"expect": "appTools.currentTool", "value": "select"},
    {"pointer": [[400, 300]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"expect": "appTools.handlesVisible", "value": true},
    {"capture": "un-trait-selectionne"},
    {"checkPixel": "poignee", "at": [295, 300], "color": "#808080", "tolerance": 40},
    {"pointer": [[700, 650], [800, 650]]},
    {"expect": "appTools.selectionCount", "value": 0},
    {"command": "tool.pen"},
    {"stroke": [[700, 680], [800, 680]], "pressure": 0.5},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"command": "edit.undo"},
    {"command": "tool.select"},
    {"pointer": [[400, 300]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"command": "tool.pen"},
    {"stroke": [[700, 680], [800, 680]], "pressure": 0.5},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"command": "edit.undo"},
    {"command": "tool.select"},
    {"pointer": [[700, 600]]},
    {"expect": "appTools.selectionCount", "value": 0},
    {"pointer": [[250, 250], [320, 450]]},
    {"expect": "appTools.selectionCount", "value": 2},
    {"capture": "deux-traits"},
    {"pointer": [[400, 350], [450, 370], [500, 390], [550, 400]]},
    {"waitReady": true},
    {"capture": "deplace"},
    {"pointer": [[900, 650]]},
    {"expect": "appTools.selectionCount", "value": 0},
    {"checkPixel": "trait-deplace", "at": [550, 350], "color": "#000000", "tolerance": 80},
    {"checkPixel": "place-quittee", "at": [300, 300], "color": "#FFFFFF", "tolerance": 8},
    {"pointer": [[420, 320], [700, 480]]},
    {"expect": "appTools.selectionCount", "value": 2},
    {"command": "object.enlarge"},
    {"waitReady": true},
    {"pointer": [[900, 650]]},
    {"expect": "appTools.selectionCount", "value": 0},
    {"waitReady": true},
    {"checkPixel": "agrandi-deborde", "at": [655, 345], "color": "#000000", "tolerance": 80},
    {"capture": "agrandi"},
    {"fixture": "objet-verrouille", "path": "${SORTIE}/s34-verrou.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/s34-verrou.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"wait": 300},
    {"pointer": [[640, 438]], "space": "window"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"command": "tool.select"},
    {"capture": "verrou-ouvert"},
    {"pointer": [[150, 150]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"pointer": [[200, 200], [250, 225], [300, 250]]},
    {"waitReady": true},
    {"checkPixel": "poignee-proportionnelle", "at": [280, 280], "color": "#808080", "tolerance": 24},
    {"capture": "poignee-glissee"},
    {"pointer": [[450, 150], [500, 200], [550, 250]]},
    {"waitReady": true},
    {"expect": "appTools.selectionCount", "value": 1},
    {"checkPixel": "verrou-en-place", "at": [450, 150], "color": "#404040", "tolerance": 24},
    {"checkPixel": "verrou-pas-deplace", "at": [550, 250], "color": "#FFFFFF", "tolerance": 8},
    {"capture": "verrouille"}
  ]
}
