{
  "format": "actcraft-scenario/1",
  "name": "reglages-gardes",
  "description": "S9 : palette ancrée à gauche, couleur personnalisée ajoutée, navigateur d'objet ouvert ; on quitte et on relance sur les mêmes dossiers d'essai (réglages et profils) : tout est restauré (lectures après la ligne RELANCE). Puis une largeur de contour changée dans le navigateur de propriétés s'annule.",
  "steps": [
    {"waitReady": true},
    {"command": "palette.dock-left"},
    {"command": "color.add", "argument": "#12AB34"},
    {"command": "browser.objects"},
    {"waitReady": true},
    {"expect": "appProfile.paletteDock", "value": "left"},
    {"expect": "appColors.extraCount", "value": 1},
    {"expect": "browserPanel.current", "value": "objets"},
    {"stroke": [[300, 400], [700, 400]], "pressure": 0.5},
    {"waitReady": true},
    {"capture": "avant"},
    {"restart": true},
    {"waitReady": true},
    {"expect": "appProfile.paletteDock", "value": "left"},
    {"expect": "appColors.extraCount", "value": 1},
    {"expect": "browserPanel.current", "value": "objets"},
    {"capture": "apres-relance"},
    {"command": "pen.color", "argument": "#000000"},
    {"command": "pen.width", "argument": 2},
    {"stroke": [[300, 400], [700, 400]], "pressure": 0.5},
    {"waitReady": true},
    {"command": "tool.select"},
    {"pointer": [[500, 400]]},
    {"waitReady": true},
    {"expect": "appTools.selectionCount", "value": 1},
    {"command": "browser.properties"},
    {"waitReady": true},
    {"expect": "browserPanel.current", "value": "proprietes"},
    {"expect": "appProperties.title", "value": "Trait"},
    {"pointer": [[145, 539]], "space": "window"},
    {"waitFor": "prop-outline-width.activeFocus", "value": true, "timeoutMs": 5000},
    {"typeText": "12"},
    {"key": "Return"},
    {"waitReady": true},
    {"expect": "documentController.canUndo", "value": true},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "appProperties.title", "value": "Page"},
    {"checkPixel": "contour-annule", "at": [400, 402], "color": "#FFFFFF", "tolerance": 60},
    {"capture": "annule"}
  ]
}
