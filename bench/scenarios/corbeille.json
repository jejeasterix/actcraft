{
  "format": "actcraft-scenario/1",
  "name": "corbeille",
  "description": "S35 : effacer les annotations et annuler, Suppr sans sélection, corbeille, rétablir la page.",
  "steps": [
    {"waitReady": true},
    {"expect": "trashCan.visible", "value": true},
    {"fixture": "rectangle-et-traits", "path": "${SORTIE}/s35.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/s35.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"command": "clear.annotations"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "edit.undo"},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"remember": "documentController.fingerprint", "as": "enregistre"},
    {"command": "tool.select"},
    {"key": "Del"},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"expect": "documentController.pageCount", "value": 1},
    {"pointer": [[150, 150]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"capture": "rectangle-selectionne"},
    {"command": "edit.delete"},
    {"expect": "documentController.shownObjectCount", "value": 2},
    {"command": "edit.undo"},
    {"expect": "documentController.shownObjectCount", "value": 3},
    {"command": "tool.pen"},
    {"stroke": [[600, 600], [700, 650]], "pressure": 0.5},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 4},
    {"command": "page.revert"},
    {"waitReady": true},
    {"expect": "documentController.fingerprint", "value": "${enregistre}"},
    {"capture": "page-retablie"}
  ]
}
