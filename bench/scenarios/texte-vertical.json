{
  "format": "actcraft-scenario/1",
  "name": "texte-vertical",
  "description": "S16 : l'outil Texte de haut en bas ouvre une colonne d'un caractère ; ABC en Arial gras s'empile (une lettre par ligne), le gras se clique sur la barre à cinq commandes, qui couvre la vue (le stylet posé sur elle ne valide pas le texte) ; Échap est pris par l'éditeur (l'outil reste Texte de haut en bas) et valide ; le document enregistré puis rouvert garde son empreinte.",
  "steps": [
    {"waitReady": true},
    {"command": "tool.text-vertical"},
    {"pointer": [[400, 200]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"expect": "appText.vertical", "value": true},
    {"expect": "verticalTextBar.visible", "value": true},
    {"expect": "textFormatBar.visible", "value": false},
    {"command": "text.font", "argument": "Arial"},
    {"expect": "appText.fontFamily", "value": "Arial"},
    {"typeText": "ABC"},
    {"expect": "appText.plainText", "value": "ABC"},
    {"expect": "appText.fontFamily", "value": "Arial"},
    {"command": "text.select-all"},
    {"pointer": [[282, 70]], "space": "window"},
    {"expect": "appText.bold", "value": true},
    {"expect": "appText.active", "value": true},
    {"stroke": [[900, 70], [901, 70]], "space": "window", "noStroke": true},
    {"expect": "appText.active", "value": true},
    {"expect": "appTools.currentTool", "value": "text-vertical"},
    {"checkPixel": "cadre-pointille", "at": [398, 198], "color": "#86A0CB", "tolerance": 50},
    {"capture": "edition"},
    {"key": "Escape"},
    {"expect": "appTools.currentTool", "value": "text-vertical"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"capture": "abc"},
    {"checkPixel": "lettre-a", "at": [407, 213], "color": "#000000", "tolerance": 110},
    {"checkPixel": "lettre-b", "at": [403, 233], "color": "#000000", "tolerance": 110},
    {"checkPixel": "lettre-c", "at": [403, 255], "color": "#000000", "tolerance": 110},
    {"remember": "documentController.fingerprint", "as": "avant"},
    {"command": "file.save-as", "argument": "${SORTIE}/v.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"command": "file.open", "argument": "${SORTIE}/v.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.fingerprint", "value": "${avant}"},
    {"capture": "rouvert"}
  ]
}
