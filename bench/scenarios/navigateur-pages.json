{
  "format": "actcraft-scenario/1",
  "name": "navigateur-pages",
  "description": "S7.4 : panneau des navigateurs, sélection de pages (clavier : le joueur n'envoie pas de modificateur à la souris), glisser une sélection, copier-coller, insertion. Miniatures suspendues panneau caché.",
  "steps": [
    {"waitReady": true},
    {"expect": "appThumbnails.active", "value": false},
    {"expect": "browserPanel.commandChecked", "value": false},
    {"command": "view.browsers"},
    {"expect": "browserPanel.visible", "value": true},
    {"expect": "appThumbnails.active", "value": true},
    {"expect": "browserPanel.commandChecked", "value": true},
    {"command": "page.next"},
    {"command": "page.next"},
    {"command": "page.next"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 4},
    {"capture": "panneau"},
    {"pointer": [[110, 328]], "space": "window"},
    {"key": "Shift+Down"},
    {"expect": "appPages.selection", "value": [1, 2]},
    {"capture": "plage"},
    {"pointer": [[110, 328], [110, 300], [110, 230], [110, 150]], "space": "window"},
    {"expect": "appPages.selection", "value": [0, 1]},
    {"capture": "deplace"},
    {"command": "page.copy"},
    {"command": "page.goto", "argument": "4"},
    {"command": "page.paste"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 6},
    {"command": "edit.undo"},
    {"expect": "documentController.pageCount", "value": 4},
    {"command": "page.insert-after"},
    {"expect": "documentController.pageCount", "value": 5},
    {"waitReady": true},
    {"capture": "colle"},
    {"pointer": [[110, 192]], "space": "window"},
    {"stroke": [[300, 300], [500, 300]], "pressure": 0.5},
    {"waitReady": true},
    {"command": "tool.select"},
    {"pointer": [[400, 300]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"key": "Delete"},
    {"expect": "appTools.selectionCount", "value": 0},
    {"expect": "documentController.pageCount", "value": 5},
    {"command": "tool.pen"},
    {"command": "page.goto", "argument": "5"},
    {"expect": "pageNavigator.currentVisible", "value": true},
    {"pointer": [[110, 730]], "space": "window"},
    {"expect": "appPages.selection", "value": [4]},
    {"expect": "documentController.pageCount", "value": 5},
    {"command": "page.insert-after"},
    {"command": "page.insert-after"},
    {"command": "page.insert-after"},
    {"command": "page.insert-after"},
    {"command": "page.goto", "argument": "9"},
    {"waitReady": true},
    {"expect": "documentController.pageCount", "value": 9},
    {"waitFor": "pageNavigator.currentVisible", "value": true, "timeoutMs": 5000},
    {"pointer": [[110, 730]], "space": "window"},
    {"expect": "appPages.selection", "value": [8]},
    {"expect": "documentController.pageCount", "value": 9},
    {"touch": [[110, 594]], "space": "window"},
    {"expect": "appPages.selection", "value": [7]},
    {"expect": "documentController.currentIndex", "value": 7},
    {"pointer": [[110, 730]], "space": "window"},
    {"expect": "appPages.selection", "value": [8]},
    {"touch": [[110, 300], [110, 400], [110, 500], [110, 600]], "space": "window"},
    {"expect": "appPages.selection", "value": [8]},
    {"expect": "documentController.currentIndex", "value": 8},
    {"expect": "pageNavigator.currentVisible", "value": false},
    {"command": "edit.undo"},
    {"command": "edit.undo"},
    {"command": "edit.undo"},
    {"command": "edit.undo"},
    {"expect": "documentController.pageCount", "value": 5},
    {"pointer": [[110, 192]], "space": "window"},
    {"expect": "pageNavigator.activeFocus", "value": true},
    {"pointer": [[700, 400]], "space": "window", "button": "right"},
    {"expect": "pageNavigator.activeFocus", "value": false},
    {"pointer": [[700, 500]], "space": "window"},
    {"command": "page.goto", "argument": "1"},
    {"pointer": [[110, 192]], "space": "window"},
    {"key": "Shift+Down"},
    {"expect": "appPages.selection", "value": [0, 1]},
    {"pointer": [[198, 276]], "space": "window"},
    {"expect": "pageNavigatorMenu.visible", "value": true},
    {"expect": "pageNavigatorOwnMenu.visible", "value": false},
    {"expect": "appPages.selection", "value": [0, 1]},
    {"pointer": [[700, 400]], "space": "window"},
    {"expect": "pageNavigatorMenu.visible", "value": false},
    {"pointer": [[196, 106]], "space": "window"},
    {"expect": "pageNavigatorOwnMenu.visible", "value": true},
    {"expect": "pageNavigatorMenu.visible", "value": false},
    {"pointer": [[700, 400]], "space": "window"},
    {"expect": "pageNavigatorOwnMenu.visible", "value": false},
    {"command": "browsers.dock-right"},
    {"waitReady": true},
    {"capture": "ancre-droite"},
    {"command": "browsers.dock-left"}
  ]
}
