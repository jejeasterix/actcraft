{
  "format": "actcraft-scenario/1",
  "name": "interactivite",
  "description": "L8-T19 (S11.1, S11.4, S11.7) : un clic sur le rond rouge masque puis réaffiche l'étiquette ; la carotte « légume » glissée dans le panier « fruit » revient ; un clic sur l'objet lié demande confirmation, Espace sur « Annuler » (focus par défaut) n'ouvre rien.",
  "steps": [
    {"waitReady": true},
    {"command": "tool.select"},
    {"expect": "appTools.currentTool", "value": "select"},
    {"fixture": "interactivite", "path": "${SORTIE}/interactivite.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/interactivite.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 6},
    {"expect": "appTools.currentTool", "value": "select"},
    {"checkPixel": "etiquette-visible", "at": [650, 150], "color": "#1E88E5", "tolerance": 40},
    {"capture": "avant"},
    {"pointer": [[150, 150]], "space": "page"},
    {"waitReady": true},
    {"checkPixel": "etiquette-masquee", "at": [650, 150], "color": "#FFFFFF", "tolerance": 30},
    {"capture": "masquee"},
    {"pointer": [[150, 150]], "space": "page"},
    {"waitReady": true},
    {"checkPixel": "etiquette-revenue", "at": [650, 150], "color": "#1E88E5", "tolerance": 40},
    {"capture": "revenue"},
    {"pointer": [[150, 500], [350, 425], [550, 350]], "space": "page"},
    {"waitReady": true},
    {"checkPixel": "revenu-hors-conteneur", "at": [150, 500], "color": "#FF8000", "tolerance": 40},
    {"checkPixel": "panier-vide", "at": [550, 350], "color": "#808080", "tolerance": 40},
    {"capture": "retour"},
    {"pointer": [[850, 550]], "space": "page"},
    {"waitFor": "linkConfirmDialog.visible", "value": true, "timeoutMs": 5000},
    {"expect": "linkConfirmDialog.visible", "value": true},
    {"waitFor": "linkConfirmDialog.opened", "value": true, "timeoutMs": 5000},
    {"expect": "linkConfirmCancel.activeFocus", "value": true},
    {"key": "Escape"},
    {"waitFor": "linkConfirmDialog.opened", "value": false, "timeoutMs": 5000},
    {"expect": "appLinks.openedCount", "value": 0}
  ]
}
