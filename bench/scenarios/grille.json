{
  "format": "actcraft-scenario/1",
  "name": "grille",
  "description": "S7.2 : créateur de grille, grille du dessus cachée sans redessin du cache, puis grille du dessous cachée avec un redessin de plus.",
  "steps": [
    {"waitReady": true},
    {"command": "tool.shape"},
    {"command": "shape.choose", "argument": "rectangle"},
    {"pointer": [[200, 200], [300, 260], [400, 320]]},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "grid.designer"},
    {"expect": "gridDesigner.visible", "value": true},
    {"expect": "appPageSettings.gridVisible", "value": true},
    {"key": "Space"},
    {"expect": "appPageSettings.gridAbove", "value": true},
    {"command": "grid.snap"},
    {"expect": "appPageSettings.gridSnap", "value": true},
    {"capture": "createur"},
    {"key": "Return"},
    {"waitReady": true},
    {"expect": "gridDesigner.visible", "value": false},
    {"capture": "grille-du-dessus"},
    {"remember": "pageView.cacheRefreshCount", "as": "avant"},
    {"command": "grid.hide"},
    {"waitReady": true},
    {"expect": "appPageSettings.gridVisible", "value": false},
    {"expect": "pageView.cacheRefreshCount", "value": "${avant}"},
    {"capture": "grille-cachee"},
    {"command": "grid.hide"},
    {"waitReady": true},
    {"expect": "appPageSettings.gridVisible", "value": true},
    {"command": "grid.designer"},
    {"expect": "gridDesigner.visible", "value": true},
    {"key": "Space"},
    {"expect": "appPageSettings.gridAbove", "value": false},
    {"key": "Return"},
    {"waitReady": true},
    {"expect": "gridDesigner.visible", "value": false},
    {"remember": "pageView.cacheRefreshCount", "as": "avantDessous"},
    {"command": "grid.hide"},
    {"waitFor": "pageView.cacheRefreshCount", "value": "${avantDessous}", "above": true, "timeoutMs": 5000},
    {"expect": "appPageSettings.gridVisible", "value": false},
    {"capture": "grille-dessous-cachee"}
  ]
}
