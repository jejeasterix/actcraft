{
  "format": "actcraft-scenario/1",
  "name": "medias",
  "description": "L8-T23 (S25) : un son inséré par la commande devient une icône au centre de la page, un second se pose à sa droite, Annuler retire le second en une étape. Puis, avec des fichiers écrits par la fixture : clic sur le son (le lecteur de sons joue), clic sur une vidéo puis trait au stylet pendant la lecture (le trait s'écrit hors du cadre de la vidéo), GIF animé dont la seconde image est lue 600 ms après l'insertion. Les images vidéo réelles n'arrivent pas hors écran sous macOS (H8-17) : seuls l'état de lecture et le trait sont lus ici.",
  "steps": [
    {"waitReady": true},
    {"fixture": "medias", "path": "${SORTIE}/medias.actcraft"},
    {"command": "file.open", "argument": "${SORTIE}/medias.actcraft"},
    {"waitFor": "documentController.busy", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 0},
    {"command": "insert.media", "argument": "${SORTIE}/son.wav"},
    {"waitFor": "documentController.shownObjectCount", "value": 1, "timeoutMs": 10000},
    {"waitReady": true},
    {"checkPixel": "icone-au-centre", "at": [462, 334], "color": "#2B2F36", "tolerance": 12},
    {"capture": "premier"},
    {"command": "insert.media", "argument": "${SORTIE}/son2.wav"},
    {"waitFor": "documentController.shownObjectCount", "value": 2, "timeoutMs": 10000},
    {"waitReady": true},
    {"checkPixel": "second-a-droite", "at": [602, 334], "color": "#2B2F36", "tolerance": 12},
    {"capture": "second"},
    {"command": "edit.undo"},
    {"waitFor": "documentController.shownObjectCount", "value": 1, "timeoutMs": 5000},
    {"waitReady": true},
    {"checkPixel": "second-retire", "at": [602, 334], "color": "#FFFFFF", "tolerance": 12},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"pointer": [[512, 384]]},
    {"waitFor": "soundController.playing", "value": true, "timeoutMs": 5000},
    {"waitReady": true},
    {"capture": "lecteur"},
    {"command": "insert.media", "argument": "${SORTIE}/clip.mp4"},
    {"waitFor": "documentController.shownObjectCount", "value": 2, "timeoutMs": 10000},
    {"waitReady": true},
    {"command": "insert.image", "argument": "${SORTIE}/anim.gif"},
    {"waitFor": "documentController.shownObjectCount", "value": 3, "timeoutMs": 10000},
    {"waitReady": true},
    {"wait": 600},
    {"checkPixel": "gif-image-2", "at": [512, 384], "color": "#0000FF", "tolerance": 40},
    {"capture": "gif"},
    {"pointer": [[752, 414]]},
    {"wait": 300},
    {"stroke": [[150, 650], [450, 650]], "pressure": 0.5},
    {"waitReady": true},
    {"checkPixel": "trait-pendant-la-video", "at": [300, 650], "color": "#000000", "tolerance": 80},
    {"capture": "video"},
    {"expect": "soundController.visible", "value": true}
  ]
}
