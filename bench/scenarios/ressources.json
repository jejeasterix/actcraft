{
  "format": "actcraft-scenario/1",
  "name": "ressources",
  "description": "S9.6 : navigateur de ressources. Une forme sélectionnée est ajoutée à « Mes ressources » (un élément), insérée dans une page neuve, puis le tampon pose trois copies de plus (quatre objets).",
  "steps": [
    {"waitReady": true},
    {"command": "tool.shape"},
    {"command": "shape.choose", "argument": "rectangle"},
    {"pointer": [[500, 200], [600, 260], [700, 320]]},
    {"waitReady": true},
    {"command": "tool.select"},
    {"pointer": [[600, 200]]},
    {"expect": "appTools.selectionCount", "value": 1},
    {"command": "browser.resources"},
    {"waitReady": true},
    {"expect": "resourceBrowser.visible", "value": true},
    {"command": "resources.mine"},
    {"waitReady": true},
    {"command": "resources.add"},
    {"waitFor": "appResources.itemCount", "value": 1, "timeoutMs": 10000},
    {"expect": "appResources.itemCount", "value": 1},
    {"waitReady": true},
    {"capture": "bibliotheque"},
    {"remember": "appResources.folder", "as": "dossier"},
    {"command": "page.next"},
    {"waitReady": true},
    {"command": "resources.insert", "argument": "${dossier}/Ressource1.actcraft"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"capture": "insere"},
    {"command": "resources.stamp"},
    {"pointer": [[200, 500]]},
    {"pointer": [[500, 500]]},
    {"pointer": [[800, 500]]},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 4},
    {"capture": "tampon"},
    {"command": "resources.stamp"}
  ]
}
