{
  "format": "actcraft-scenario/1",
  "name": "pseudo-langue",
  "description": "Pseudo-langue de contrôle (L11-T19, D11-14) : l'interface est chargée avec la traduction « ⟦source⟧ » (--traduction) ; chaque étape visibleTexts liste les textes visibles qui ne sont pas passés par la traduction. Fenêtre principale, menu Fichier, À propos, taille de page, réglages. Hors de « tous » (sous-dossier controle/). Données ignorées : raccourcis clavier (commandShortcut) et valeurs numériques des boîtes de taille (pageSizeValue : texte saisi des boîtes), lien du projet et avis tiers (données : projectLink, aboutNotices).",
  "steps": [
    {
      "waitReady": true
    },
    {
      "visibleTexts": "pseudo",
      "ignore": [
        "pageIndicator",
        "zoomLabel",
        "commandShortcut",
        "projectLink",
        "aboutNotices"
      ]
    },
    {
      "capture": "principale"
    },
    {
      "pointer": [
        [
          36,
          22
        ]
      ],
      "space": "window"
    },
    {
      "waitFor": "menu-file.visible",
      "value": true
    },
    {
      "visibleTexts": "pseudo",
      "ignore": [
        "pageIndicator",
        "zoomLabel",
        "commandShortcut",
        "projectLink",
        "aboutNotices"
      ]
    },
    {
      "capture": "menu-fichier"
    },
    {
      "key": "Esc"
    },
    {
      "wait": 200
    },
    {
      "command": "help.about"
    },
    {
      "waitFor": "aboutDialog.visible",
      "value": true
    },
    {
      "visibleTexts": "pseudo",
      "ignore": [
        "pageIndicator",
        "zoomLabel",
        "commandShortcut",
        "projectLink",
        "aboutNotices"
      ]
    },
    {
      "capture": "a-propos"
    },
    {
      "key": "Esc"
    },
    {
      "wait": 200
    },
    {
      "command": "file.new-custom"
    },
    {
      "waitFor": "pageSizeDialog.visible",
      "value": true
    },
    {
      "visibleTexts": "pseudo",
      "ignore": [
        "pageIndicator",
        "zoomLabel",
        "commandShortcut",
        "projectLink",
        "aboutNotices",
        "pageSizeValue"
      ]
    },
    {
      "capture": "taille-page"
    },
    {
      "key": "Esc"
    },
    {
      "wait": 200
    },
    {
      "command": "profile.edit"
    },
    {
      "waitFor": "profileEditorPopup.visible",
      "value": true
    },
    {
      "visibleTexts": "pseudo",
      "ignore": [
        "pageIndicator",
        "zoomLabel",
        "commandShortcut",
        "projectLink",
        "aboutNotices"
      ]
    },
    {
      "capture": "reglages"
    }
  ]
}
