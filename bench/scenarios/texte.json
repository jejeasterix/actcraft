{
  "format": "actcraft-scenario/1",
  "name": "texte",
  "description": "S7.3 : un appui avec l'outil texte ouvre l'éditeur, la frappe remplace « Votre texte », Ctrl+B et Ctrl+I sont pris par l'éditeur (D8) au lieu d'ouvrir les navigateurs ou d'insérer une page, la validation par changement d'outil garde le texte (une étape), un texte vidé est oublié, Échap valide (D7) : le texte neuf est gardé, Annuler le retire en une étape.",
  "steps": [
    {"waitReady": true},
    {"command": "tool.text"},
    {"pointer": [[300, 300]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"expect": "appText.active", "value": true},
    {"expect": "textFormatBar.visible", "value": true},
    {"typeText": "Bonjour"},
    {"expect": "appText.plainText", "value": "Bonjour"},
    {"key": "Ctrl+B"},
    {"expect": "browserPanel.visible", "value": false},
    {"expect": "appText.bold", "value": true},
    {"key": "Ctrl+I"},
    {"expect": "documentController.pageCount", "value": 1},
    {"expect": "appText.italic", "value": true},
    {"key": "Ctrl+I"},
    {"expect": "appText.italic", "value": false},
    {"expect": "documentController.pageCount", "value": 1},
    {"stroke": [[485, 70], [486, 70]], "space": "window", "noStroke": true},
    {"expect": "appText.active", "value": true},
    {"command": "text.select-all"},
    {"expect": "appText.selectionStart", "value": 0},
    {"expect": "appText.selectionEnd", "value": 7},
    {"expect": "appText.bold", "value": true},
    {"capture": "edition"},
    {"capture": "barre"},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"checkPixel": "texte-encre", "at": [304, 310], "color": "#000000", "tolerance": 110},
    {"capture": "valide"},
    {"command": "tool.text"},
    {"pointer": [[600, 600]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"command": "text.select-all"},
    {"key": "Delete"},
    {"expect": "appText.plainText", "value": ""},
    {"command": "tool.pen"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 0},
    {"command": "tool.text"},
    {"pointer": [[300, 450]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"typeText": "Salut"},
    {"key": "Escape"},
    {"expect": "appTools.currentTool", "value": "text"},
    {"waitFor": "appText.active", "value": false, "timeoutMs": 10000},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 1},
    {"command": "edit.undo"},
    {"waitReady": true},
    {"expect": "documentController.shownObjectCount", "value": 0},
    {"capture": "echap-valide"},
    {"command": "tool.text"},
    {"pointer": [[300, 450]]},
    {"waitFor": "appText.active", "value": true, "timeoutMs": 10000},
    {"typeText": "Perdu"},
    {"command": "file.close"},
    {"waitFor": "saveChangesDialog.opened", "value": true, "timeoutMs": 10000},
    {"expect": "appText.active", "value": false},
    {"expect": "documentController.shownObjectCount", "value": 1}
  ]
}
